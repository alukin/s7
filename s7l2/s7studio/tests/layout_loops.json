{
  "name": "layout_loops",
  "elements": [
    { "id": "src", "type": "Constant", "params": { "value": 1.0 } },
    { "id": "add", "type": "Adder", "params": { "weights": [1, 1] } },
    { "id": "g1", "type": "Gain", "params": { "factor": 0.5 } },
    { "id": "g2", "type": "Gain", "params": { "factor": 0.5 } },
    { "id": "d", "type": "Delay", "params": { "initial_value": 0.0 } },
    { "id": "side", "type": "Gain", "params": { "factor": 2.0 } },
    { "id": "scope", "type": "Scope", "params": { "channel_count": 3 } }
  ],
  "connections": [
    { "from_element": "src", "from_port": 0, "to_element": "add", "to_port": 0 },
    { "from_element": "d", "from_port": 0, "to_element": "add", "to_port": 1 },
    { "from_element": "add", "from_port": 0, "to_element": "g1", "to_port": 0 },
    { "from_element": "g1", "from_port": 0, "to_element": "g2", "to_port": 0 },
    { "from_element": "g2", "from_port": 0, "to_element": "d", "to_port": 0 },
    { "from_element": "src", "from_port": 0, "to_element": "side", "to_port": 0 },
    { "from_element": "side", "from_port": 0, "to_element": "scope", "to_port": 0 },
    { "from_element": "g2", "from_port": 0, "to_element": "scope", "to_port": 1 },
    { "from_element": "add", "from_port": 0, "to_element": "scope", "to_port": 2 }
  ]
}
