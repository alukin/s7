#!/usr/bin/env bash
# Builds S7 for Linux (GCC 15+ or Clang 22+) in build/ (build-release/ with --release).
#
# Usage: ./build_for_linux [--release] [--no-studio] [--test]
#   --release    optimized build in build-release/ (tests that use assert() check nothing there)
#   --no-studio  skip s7studio (no Qt needed)
#   --test       run the tests after building
# Set S7_BUILD_JOBS to override the conservative default of 2 compile jobs.
# Dependencies: tools/install_deps_ubuntu.sh. Compiler: set CXX (e.g. CXX=clang++-22) on the first build.

# SPDX-FileCopyrightText: Oleksiy Lukin and S7 contributors
# SPDX-License-Identifier: GPL-3.0-or-later

set -euo pipefail
cd "$(dirname "$0")"

BUILD=build
ARGS=(-DS7_BUILD_STUDIO=ON)
TEST=0
for arg in "$@"; do
    case "$arg" in
        --release) BUILD=build-release; ARGS+=(-DCMAKE_BUILD_TYPE=Release) ;;
        --no-studio) ARGS+=(-DS7_BUILD_STUDIO=OFF) ;;
        --test) TEST=1 ;;
        -h|--help) awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$0"; exit 0 ;;
        *) echo "Unknown option: $arg (see --help)" >&2; exit 2 ;;
    esac
done

JOBS="${S7_BUILD_JOBS:-2}"
if [[ ! "$JOBS" =~ ^[1-9][0-9]*$ ]]; then
    echo "S7_BUILD_JOBS must be a positive integer (got: $JOBS)" >&2
    exit 2
fi

# A new build directory uses Ninja when available; an existing one keeps its generator.
if [ ! -f "$BUILD/CMakeCache.txt" ] && command -v ninja > /dev/null; then
    ARGS+=(-G Ninja)
fi
cmake -S . -B "$BUILD" "${ARGS[@]}"
cmake --build "$BUILD" --parallel "$JOBS"
if (( TEST )); then
    cmake --build "$BUILD" --target build-tests --parallel "$JOBS"
    ctest --test-dir "$BUILD" --output-on-failure --parallel "$JOBS"
fi
echo "Built in $BUILD/. Run programs with ./run_on_linux$( [ "$BUILD" = build ] || echo ' --release') <program>."
