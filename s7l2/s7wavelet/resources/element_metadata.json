          "type": "F64",
          "optional": false,
          "type_rule": ""
        }
      ],
      "output_ports": [
        {
          "name": "coefficient",
          "description": "Delayed complex Morlet coefficient",
          "type": "C64",
          "optional": false,
          "type_rule": ""
        },
        {
          "name": "valid",
          "description": "Full-support coefficient validity",
          "type": "F64",
          "optional": false,
          "type_rule": ""
        },
        {
          "name": "delay_samples",
          "description": "Explicit center delay in samples",
          "type": "F64",
          "optional": false,
          "type_rule": ""
        }
      ],
      "parameters": [
        {
          "name": "frequency_hz",
          "type": "real",
          "description": "Positive center frequency below Nyquist; finite support at most 65535 samples",
          "default": 25,
          "required": false,
          "min": 0,
          "enum_values": []
        },
        {
          "name": "cycles",
