{
  "name": "stereo-frame-producer",
  "elements": [
    {
      "id": "left",
      "type": "Constant",
      "params": {
        "type": "F32",
        "value": 0.25
      }
    },
    {
      "id": "right",
      "type": "Constant",
      "params": {
        "type": "F32",
        "value": -0.5
      }
    },
    {
      "id": "frames",
      "type": "NetFrameSink",
      "params": {
        "stream_id": "197488c5-1100-4000-8000-000000000002",
        "type": "F32",
        "channels": [
          "L",
          "R"
        ],
        "frame_rate": [
          48000,
          1
        ],
        "encoding": "raw",
        "max_frames_per_packet": 128,
        "window_packets": 4,
        "max_block_ms": 30000,
        "max_wait_ms": 30000
      }
    }
  ],
  "connections": [
    {
      "from_element": "left",
      "from_port": 0,
      "to_element": "frames",
      "to_port": 0
    },
    {
      "from_element": "right",
      "from_port": 0,
      "to_element": "frames",
      "to_port": 1
    }
  ],
  "websocket": {
    "server": {
      "enabled": true,
      "bind_address": "127.0.0.1",
      "port": 9012,
      "tls": {
        "enabled": true,
        "cert_file": "s7runtime/examples/certs/s7_runtime_node.cert.pem",
        "key_file": "s7runtime/examples/certs/s7_runtime_node.key.pem",
        "ca_file": "s7runtime/examples/certs/s7_root_ca.cert.pem",
        "require_client_cert": true
      }
    }
  },
  "execution": {
    "step_rate_hz": 48000
  }
}
