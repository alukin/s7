    {"from_element": "pack", "from_port": 0, "to_element": "gain", "to_port": 0},
    {"from_element": "gain", "from_port": 0, "to_element": "forward", "to_port": 0},
    {"from_element": "forward", "from_port": 0, "to_element": "unpack", "to_port": 0},
