#!/bin/sh
# SPDX-FileCopyrightText: Oleksiy Lukin and S7 contributors
# SPDX-License-Identifier: GPL-3.0-or-later

# Runs a Windows program of this build under Wine. Generated by CMake from
# tools/windows/wine-run.sh.in; the build's DLL directories and the sysroot's
# bin/ are on WINEPATH. The Wine prefix lives in the build directory.
export WINEPREFIX="${WINEPREFIX:-@S7_WINE_PREFIX@}"
export WINEPATH="@S7_WINE_DLL_PATH@"
export WINEDEBUG="${WINEDEBUG:--all}"
# No Mono/Gecko installers; a crash fails the test instead of waiting in winedbg.
export WINEDLLOVERRIDES="${WINEDLLOVERRIDES:-mscoree,mshtml=;winedbg.exe=d}"
# Tests that must not reach the user's desktop set S7_WINE_HEADLESS=1: Wine
# then has no display at all (an empty DISPLAY is not the same as none).
if [ -n "${S7_WINE_HEADLESS:-}" ]; then
    unset DISPLAY WAYLAND_DISPLAY
fi
if [ ! -f "$WINEPREFIX/system.reg" ]; then
    mkdir -p "$WINEPREFIX"
    flock "$WINEPREFIX/.s7-init.lock" sh -c '[ -f "$WINEPREFIX/system.reg" ] || { wineboot -i && wineserver -w; }' >/dev/null 2>&1
fi
exec wine "$@"
