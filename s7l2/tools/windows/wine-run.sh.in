#!/bin/sh
# SPDX-FileCopyrightText: Oleksiy Lukin and S7 contributors
# SPDX-License-Identifier: GPL-3.0-or-later

# Runs a Windows program of this build under Wine. Generated by CMake from
# tools/windows/wine-run.sh.in; the build's DLL directories and the sysroot's
# bin/ are on WINEPATH. The Wine prefix lives in the build directory.
S7_WINE_DEFAULT_PREFIX="@S7_WINE_PREFIX@"
if [ -n "${S7_WINE_HEADLESS:-}" ]; then
    S7_WINE_DEFAULT_PREFIX="${S7_WINE_DEFAULT_PREFIX}-headless"
    unset DISPLAY WAYLAND_DISPLAY
fi
export WINEPREFIX="${WINEPREFIX:-$S7_WINE_DEFAULT_PREFIX}"
export WINEPATH="@S7_WINE_DLL_PATH@"
export WINEDEBUG="${WINEDEBUG:--all}"
# No Mono/Gecko installers; a crash fails the test instead of waiting in winedbg.
export WINEDLLOVERRIDES="${WINEDLLOVERRIDES:-mscoree,mshtml=;winedbg.exe=d}"
if [ ! -f "$WINEPREFIX/system.reg" ]; then
    mkdir -p "$WINEPREFIX"
    flock "$WINEPREFIX/.s7-init.lock" sh -c '[ -f "$WINEPREFIX/system.reg" ] || { wineboot -i && wineserver -w; }' >/dev/null 2>&1
fi
if [ -n "${S7_WINE_HEADLESS:-}" ]; then
    # Fedora 45 Wine filters QT_* from the Unix environment. Configure the
    # Windows environment in the separate test prefix, never the interactive
    # prefix, so Qt uses its offscreen plugin before creating any windows.
    flock "$WINEPREFIX/.s7-headless-settings.lock" sh -ec '
        if [ ! -f "$WINEPREFIX/.s7-offscreen-platform" ]; then
            if ! wine reg add "HKCU\Environment" /v QT_QPA_PLATFORM /t REG_SZ /d offscreen /f >"$WINEPREFIX/.s7-headless-settings.log" 2>&1; then
                cat "$WINEPREFIX/.s7-headless-settings.log" >&2
                exit 1
            fi
            touch "$WINEPREFIX/.s7-offscreen-platform"
        fi
    '
fi
exec wine "$@"
