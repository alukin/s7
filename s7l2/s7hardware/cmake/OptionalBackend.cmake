function(s7_optional_backend name package platform_supported)
    set(S7_${name} AUTO CACHE STRING "${name} provider: AUTO, ON, OFF")
    set_property(CACHE S7_${name} PROPERTY STRINGS AUTO ON OFF)
    if(NOT S7_${name} MATCHES "^(AUTO|ON|OFF)$")
        message(FATAL_ERROR "S7_${name} must be AUTO, ON, or OFF")
    endif()
    set(found FALSE)
    if(NOT S7_${name} STREQUAL "OFF" AND platform_supported)
        find_package(PkgConfig QUIET)
        if(PkgConfig_FOUND)
            pkg_check_modules(S7_DEP_${name} QUIET IMPORTED_TARGET ${package})
            set(found ${S7_DEP_${name}_FOUND})
        endif()
    endif()
    if(S7_${name} STREQUAL "ON" AND NOT found)
        message(FATAL_ERROR "S7_${name}=ON requires ${package} development files on a supported platform")
    endif()
    set(S7_HAVE_${name} ${found} PARENT_SCOPE)
    set_property(GLOBAL PROPERTY S7_HAVE_${name} ${found})
    message(STATUS "S7 ${name} provider: ${found} (${S7_${name}})")
endfunction()
