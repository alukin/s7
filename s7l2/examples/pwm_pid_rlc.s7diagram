        "params": {
          "text": "PID: Kp=0.04, Ki=8, Kd=0.0004, derivative filter tau=2 ms.\nDerivative on measured voltage; back-calculation anti-windup gain=100 /s.\nDuty is clamped to [0,1] and latched at each PWM period boundary.",
          "width": 1450,
          "height": 105,
          "font_size": 10
        }
      },
