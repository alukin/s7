    "text_frames": [
      {
        "id": "notes",
        "position": [
          2,
          2
        ],
        "params": {
          "text": "RC low-pass: τ = 0.1 s\nRun 2 s at 1000 Hz; open the time scopes, then Frequency response → Analyze captured impulse.\nThe output decays exponentially; the corner is near 1/(2πτ) = 1.59 Hz.\nPulse area = 1; inspect input and output separately so the pulse does not hide the response.",
          "width": 1040,
          "height": 160,
          "font_size": 12
        }
      }
    ]
