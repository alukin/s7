    "text_frames": [
      {
        "id": "notes",
        "position": [
          2,
          2
        ],
        "params": {
          "text": "RLC_RESONANCE / SYMPLECTIC\nDefault dt=0.001 s (1 kHz); run 10 s, resonance 30 s. Open Scope.\nEquations, units, experiments and limits: examples/linear/README.md.\nState at runtime step k represents (k-1)*dt; Scope labels k*dt.\nExperimental teaching model; manual Studio workflow not yet qualified.",
          "width": 1650,
          "height": 200,
          "font_size": 10
        }
