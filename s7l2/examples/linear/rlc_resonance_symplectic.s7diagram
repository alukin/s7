{
  "id": "rlc_resonance_symplectic",
  "dt": 0.001,
  "document_kind": "s7.diagram",
  "diagram_version": 2,
  "sheet": {
    "orientation": "landscape",
    "width_mm": 490,
    "height_mm": 210
  },
  "schema": {
    "name": "rlc_resonance_symplectic",
    "elements": [
      {
        "id": "source",
        "type": "AnalogOscillator",
        "params": {
          "amplitude": 1,
          "frequency_hz": 0.3183098861837907,
          "sample_rate_hz": 1000,
          "phase": 0
        }
      },
      {
        "id": "state",
        "type": "SymplecticIntegrator",
        "params": {
          "dt": 0.001,
          "initial_position": 0.0,
          "initial_velocity": 0
        }
      },
      {
        "id": "derivative",
        "type": "Adder",
        "params": {
          "weights": [
            1,
            -1,
            -4
          ]
        }
      },
      {
        "id": "capacitor_voltage",
        "type": "Gain",
        "params": {
          "factor": 4
        }
      }
    ],
    "connections": [
      {
        "from_element": "source",
        "from_port": 0,
        "to_element": "derivative",
        "to_port": 0
      },
      {
        "from_element": "state",
        "from_port": 1,
        "to_element": "derivative",
        "to_port": 1
      },
      {
        "from_element": "state",
        "from_port": 0,
        "to_element": "derivative",
        "to_port": 2
      },
      {
        "from_element": "derivative",
        "from_port": 0,
        "to_element": "state",
        "to_port": 0
      },
      {
        "from_element": "state",
        "from_port": 0,
        "to_element": "capacitor_voltage",
        "to_port": 0
      }
    ]
  },
  "probes": [
    {
      "name": "charge",
      "element": "state",
      "port": 0,
      "unit": "C"
    },
    {
      "name": "current",
      "element": "state",
      "port": 1,
      "unit": "A"
    },
    {
      "name": "capacitor_voltage",
      "element": "capacitor_voltage",
      "port": 0,
      "unit": "V"
    },
    {
      "name": "input",
      "element": "source",
      "port": 0,
      "unit": "V"
    }
  ],
  "diagram": {
    "grid": {
      "step": 20,
      "mm_per_step": 5.291666666666667
    },
    "nodes": [
      {
        "id": "source",
        "position": [
          3,
          18
        ],
        "title": "Applied voltage: 1 V sin(2t)"
      },
      {
        "id": "state",
        "position": [
          47,
          18
        ],
        "title": "Charge / current"
      },
      {
        "id": "derivative",
        "position": [
          21,
          18
        ],
        "title": "q'' = Vs - q' - 4q"
      },
      {
        "id": "capacitor_voltage",
        "position": [
          65,
          12
        ],
        "title": "Vc = q/C (V)"
      },
      {
        "id": "scope",
        "position": [
          78,
          20
        ],
        "observer": true,
        "type": "Scope",
        "params": {
          "channel_count": 4,
          "channel_names": [
            "charge",
            "current",
            "capacitor_voltage",
            "input"
          ]
        }
      }
    ],
    "wires": [
      {
        "id": "w1",
        "from": {
          "port": [
            "source",
            "out",
