{
  "id": "rc_charge_euler",
  "dt": 0.001,
  "document_kind": "s7.diagram",
  "diagram_version": 2,
  "sheet": {
    "orientation": "landscape",
    "width_mm": 490,
    "height_mm": 210
  },
  "schema": {
    "name": "rc_charge_euler",
    "elements": [
      {
        "id": "source",
        "type": "Constant",
        "params": {
          "value": 1.0
        }
      },
      {
        "id": "state",
        "type": "EulerIntegrator",
        "params": {
          "dt": 0.001,
          "initial_value": 0.0
        }
      },
      {
        "id": "derivative",
        "type": "Adder",
        "params": {
          "weights": [
            1,
            -1
          ]
        }
      }
    ],
    "connections": [
      {
        "from_element": "source",
        "from_port": 0,
        "to_element": "derivative",
        "to_port": 0
      },
      {
        "from_element": "state",
        "from_port": 0,
        "to_element": "derivative",
        "to_port": 1
      },
      {
        "from_element": "derivative",
        "from_port": 0,
        "to_element": "state",
        "to_port": 0
      }
    ]
  },
  "probes": [
    {
      "name": "voltage",
      "element": "state",
      "port": 0,
      "unit": "V"
    },
    {
      "name": "input",
      "element": "source",
      "port": 0,
      "unit": "V"
    }
  ],
  "diagram": {
    "grid": {
      "step": 20,
      "mm_per_step": 5.291666666666667
    },
    "nodes": [
      {
        "id": "source",
        "position": [
          3,
          18
        ],
        "title": "Applied voltage (V)"
      },
      {
        "id": "state",
        "position": [
          43,
          18
        ],
        "title": "Capacitor voltage (V)"
      },
      {
        "id": "derivative",
        "position": [
          23,
          18
        ],
        "title": "Voltage derivative: (Vs - Vc)/RC; RC = 1 s"
      },
      {
        "id": "scope",
        "position": [
          78,
          20
        ],
        "observer": true,
        "type": "Scope",
        "params": {
          "channel_count": 2,
          "channel_names": [
            "voltage",
            "input"
          ]
        }
      }
    ],
    "wires": [
      {
        "id": "w1",
        "from": {
          "port": [
            "source",
            "out",
            0
          ]
        },
        "to": {
          "port": [
            "derivative",
            "in",
            0
          ]
        },
        "bends": []
      },
      {
        "id": "w2",
        "from": {
          "port": [
            "state",
            "out",
            0
          ]
        },
        "to": {
          "port": [
            "derivative",
            "in",
            1
          ]
        },
        "bends": []
      },
      {
        "id": "w3",
        "from": {
          "port": [
            "derivative",
            "out",
            0
          ]
        },
        "to": {
          "port": [
            "state",
            "in",
            0
          ]
        },
        "bends": []
      },
      {
        "id": "w4",
        "from": {
          "port": [
            "state",
            "out",
            0
          ]
        },
        "to": {
          "port": [
            "scope",
            "in",
            0
          ]
        },
        "bends": []
      },
      {
        "id": "w5",
        "from": {
          "port": [
            "source",
            "out",
            0
          ]
        },
        "to": {
          "port": [
            "scope",
            "in",
            1
          ]
        },
        "bends": []
      }
    ],
    "text_frames": [
      {
        "id": "notes",
        "position": [
          2,
          2
        ],
        "params": {
          "text": "RC_CHARGE / EULER\nDefault dt=0.001 s (1 kHz); run 10 s, resonance 30 s. Open Scope.\nEquations, units, experiments and limits: examples/linear/README.md.\nState at runtime step k represents (k-1)*dt; Scope labels k*dt.\nExperimental teaching model; manual Studio workflow not yet qualified.",
          "width": 1650,
          "height": 200,
          "font_size": 10
        }
      }
    ]
  }
}
