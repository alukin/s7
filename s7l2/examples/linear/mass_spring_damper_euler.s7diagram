{
  "id": "mass_spring_damper_euler",
  "dt": 0.001,
  "document_kind": "s7.diagram",
  "diagram_version": 2,
  "sheet": {
    "orientation": "landscape",
    "width_mm": 490,
    "height_mm": 210
  },
  "schema": {
    "name": "mass_spring_damper_euler",
    "elements": [
      {
        "id": "source",
        "type": "Constant",
        "params": {
          "value": 0.0
        }
      },
      {
        "id": "velocity",
        "type": "EulerIntegrator",
        "params": {
          "dt": 0.001,
          "initial_value": 0
        }
      },
      {
        "id": "position",
        "type": "EulerIntegrator",
        "params": {
          "dt": 0.001,
          "initial_value": 1.0
        }
      },
      {
        "id": "derivative",
        "type": "Adder",
        "params": {
          "weights": [
            1,
            -1,
            -4
          ]
        }
      }
    ],
    "connections": [
      {
        "from_element": "velocity",
        "from_port": 0,
        "to_element": "position",
        "to_port": 0
      },
      {
        "from_element": "source",
        "from_port": 0,
        "to_element": "derivative",
        "to_port": 0
      },
      {
        "from_element": "velocity",
        "from_port": 0,
        "to_element": "derivative",
        "to_port": 1
      },
      {
        "from_element": "position",
        "from_port": 0,
        "to_element": "derivative",
        "to_port": 2
      },
      {
        "from_element": "derivative",
        "from_port": 0,
        "to_element": "velocity",
        "to_port": 0
      }
    ]
  },
  "probes": [
    {
      "name": "position",
      "element": "position",
      "port": 0,
      "unit": "m"
    },
    {
      "name": "velocity",
      "element": "velocity",
      "port": 0,
      "unit": "m/s"
    },
    {
      "name": "input",
      "element": "source",
      "port": 0,
      "unit": "N"
    }
  ],
  "diagram": {
    "grid": {
      "step": 20,
      "mm_per_step": 5.291666666666667
    },
    "nodes": [
      {
        "id": "source",
        "position": [
          3,
          18
        ],
        "title": "Applied force (N)"
      },
      {
        "id": "velocity",
        "position": [
          37,
          18
        ],
        "title": "Velocity (m/s)"
      },
      {
        "id": "position",
