      {
        "id": "notes",
        "position": [
          2,
          2
        ],
        "params": {
          "text": "SDR LIVE SPECTRUM  |  LibreSDR / ADALM-Pluto at ip:analog.local, receive only\nSdrSource tuned to 88.9 MHz at 672 kS/s; ComplexToReIm splits I and Q into the Live spectrum curve.\nThe FM station at 88.7 MHz appears 200 kHz left of centre. Run continuously, then double-click \"spectrum\".\nEdit frequency_hz in the receiver options (and centre_hz of the viewer) to look elsewhere.\nGuide: examples/sdr/LIVE_SPECTRUM.md",
          "width": 760,
          "height": 172,
          "font_size": 14
        }
      }
    ]
