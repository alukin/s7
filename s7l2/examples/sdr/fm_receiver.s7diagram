  "schema": {
    "name": "fm_receiver",
    "elements": [
      {
        "id": "receiver",
        "type": "SdrSource",
        "params": {
          "type": "C32",
          "backend": "soapy",
          "device": "driver=plutosdr,uri=ip:analog.local",
          "channels": [
            "0"
          ],
          "frame_rate": [
            672000,
            1
          ],
          "block_frames": 8192,
          "queue_frames": 32768,
          "options": "{\"frequency_hz\":\"88700000\",\"bandwidth_hz\":\"500000\",\"antenna\":\"A_BALANCED\",\"gain_mode\":\"auto\"}"
        }
      },
      {
        "id": "channel",
        "type": "Resampler",
        "params": {
          "type": "C32"
        }
      },
      {
        "id": "demod",
        "type": "FmDemodulator",
        "params": {
          "sample_rate_hz": 336000,
          "deviation_hz": 75000
        }
      },
      {
        "id": "stereo",
        "type": "FmStereoDecoder",
        "params": {
          "sample_rate_hz": 336000,
          "deemphasis_us": 50
        }
      },
      {
        "id": "left",
        "type": "Resampler",
        "params": {
          "type": "F32"
        }
      },
      {
        "id": "right",
        "type": "Resampler",
        "params": {
          "type": "F32"
        }
      },
      {
        "id": "playback",
        "type": "AudioSink",
        "params": {
          "type": "F32",
          "backend": "pipewire",
          "device": "default",
          "channels": [
            "0",
            "1"
          ],
          "frame_rate": [
            48000,
            1
          ],
          "block_frames": 512,
          "queue_frames": 32768,
          "options": "{\"underrun\":\"rebuffer\"}"
        }
      }
    ],
    "connections": [
      {
        "from_element": "receiver",
