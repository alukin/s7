{
  "id": "nonlinear_pendulum_symplectic",
  "dt": 0.001,
  "document_kind": "s7.diagram",
  "diagram_version": 2,
  "sheet": {
    "orientation": "landscape",
    "width_mm": 420.0,
    "height_mm": 210.0
  },
  "schema": {
    "name": "nonlinear_pendulum_symplectic",
    "elements": [
      {
        "id": "state",
        "type": "SymplecticIntegrator",
        "params": {
          "dt": 0.001,
          "initial_position": 1.5,
          "initial_velocity": 0.0
        }
      },
      {
        "id": "sin_theta",
        "type": "Trig",
        "params": {
          "function": "sin"
        }
      },
      {
        "id": "gravity",
        "type": "Gain",
        "params": {
          "factor": -9.81
        }
      }
    ],
    "connections": [
      {
        "from_element": "state",
        "from_port": 0,
        "to_element": "sin_theta",
        "to_port": 0
      },
      {
        "from_element": "sin_theta",
        "from_port": 0,
        "to_element": "gravity",
        "to_port": 0
      },
      {
        "from_element": "gravity",
        "from_port": 0,
        "to_element": "state",
        "to_port": 0
      }
    ]
  },
  "probes": [
    {
      "name": "theta",
      "element": "state",
      "port": 0,
      "unit": "rad"
    },
    {
      "name": "omega",
      "element": "state",
      "port": 1,
      "unit": "rad/s"
    }
  ],
  "diagram": {
    "grid": {
      "step": 20,
      "mm_per_step": 5.291666666666667
    },
    "nodes": [
      {
        "id": "state",
        "position": [
          47,
          18
        ],
        "title": "Angle / angular velocity"
      },
      {
        "id": "sin_theta",
        "position": [
          5,
          18
        ],
        "title": "sin(angle)"
      },
      {
        "id": "gravity",
        "position": [
          19,
          18
        ],
        "title": "-g/l = -9.81 per s^2"
      },
      {
        "id": "scope_states",
        "position": [
          65,
          18
        ],
        "observer": true,
        "type": "Scope",
        "params": {
          "channel_count": 2,
          "channel_names": [
            "theta",
            "omega"
          ]
        }
      }
    ],
    "wires": [
      {
        "id": "w1",
        "from": {
          "port": [
            "state",
            "out",
            0
          ]
        },
        "to": {
          "port": [
            "sin_theta",
            "in",
            0
          ]
        },
        "bends": []
      },
      {
        "id": "w2",
        "from": {
          "port": [
            "sin_theta",
            "out",
            0
          ]
        },
        "to": {
          "port": [
            "gravity",
            "in",
            0
          ]
        },
        "bends": []
      },
      {
        "id": "w3",
        "from": {
          "port": [
            "gravity",
            "out",
            0
          ]
        },
        "to": {
          "port": [
            "state",
            "in",
            0
          ]
        },
        "bends": []
      },
      {
        "id": "w4",
        "from": {
          "port": [
            "state",
            "out",
            0
          ]
        },
        "to": {
          "port": [
            "scope_states",
            "in",
            0
          ]
        },
        "bends": []
      },
      {
        "id": "w5",
        "from": {
          "port": [
            "state",
            "out",
            1
          ]
        },
        "to": {
          "port": [
            "scope_states",
            "in",
            1
          ]
        },
        "bends": []
      }
    ],
    "text_frames": [
      {
        "id": "model_notes",
        "position": [
          2,
          2
        ],
        "params": {
          "text": "NONLINEAR SINGLE PENDULUM / SYMPLECTIC\ntheta'' = -9.81*sin(theta), theta(0)=1.5 rad, omega(0)=0 rad/s.\nRun Configuration: 100 model seconds at 1 and 10 kHz; default dt=0.001 s.\nE = omega^2/2 + 9.81*(1-cos(theta)); exact period from complete elliptic integral.\nReference and predeclared quality budgets: examples/pendulum/README.md. Euler is a drift baseline, expected to FAIL the long-run accuracy budgets.\nTrapezoid solves the nonlinear endpoint jointly; reduce dt on nonconvergence.\nState after runtime step k is z[k-1], observation timestamp is k*dt.",
          "width": 1450.0,
          "height": 200.0,
          "font_size": 10
        }
      }
    ]
  }
}
