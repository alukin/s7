  "schema": {
    "name": "dc_motor_p",
    "dt": 0.001,
    "elements": [
      {
        "id": "reference_step",
        "type": "StepGenerator",
        "params": {
          "initial_value": 0,
          "final_value": 0.6,
          "sample_rate_hz": 1000.0,
          "start_sample": 500
        }
      },
      {
        "id": "overload",
        "type": "StepGenerator",
        "params": {
          "initial_value": 0,
          "final_value": 1.4,
          "sample_rate_hz": 1000.0,
          "start_sample": 2000
        }
      },
      {
        "id": "release",
        "type": "StepGenerator",
        "params": {
          "initial_value": 0,
          "final_value": -1.4,
          "sample_rate_hz": 1000.0,
          "start_sample": 4000
        }
      },
      {
        "id": "reference",
        "type": "Adder",
        "params": {
          "weights": [
            1,
            1,
            1
          ]
        }
      },
      {
        "id": "load",
        "type": "StepGenerator",
        "params": {
          "initial_value": 0,
          "final_value": 0.1,
          "sample_rate_hz": 1000.0,
          "start_sample": 6000
        }
      },
      {
        "id": "error",
        "type": "Adder",
        "params": {
          "weights": [
            1,
            -1
          ]
        }
      },
      {
        "id": "proportional",
        "type": "Gain",
        "params": {
          "factor": 1.2
        }
      },
      {
        "id": "controller",
        "type": "Saturation",
        "params": {
          "lower_limit": -1,
          "upper_limit": 1
        }
      },
      {
        "id": "armature_voltage",
        "type": "Gain",
        "params": {
          "factor": 4
        }
      },
      {
        "id": "current_rate",
        "type": "Adder",
        "params": {
          "weights": [
            10,
            -10,
            -5
          ]
        }
      },
      {
        "id": "current",
        "type": "EulerIntegrator",
        "params": {
          "dt": 0.001,
          "initial_value": 0
        }
      },
      {
        "id": "speed_rate",
        "type": "Adder",
        "params": {
          "weights": [
            5,
            -1,
            -10
          ]
        }
      },
      {
        "id": "speed",
