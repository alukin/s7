        "to_port": 1
      },
      {
        "from_element": "mixer",
        "from_port": 0,
        "to_element": "twice_mixer",
        "to_port": 0
      },
      {
        "from_element": "twice_mixer",
        "from_port": 0,
        "to_element": "lowpass",
        "to_port": 0
      },
      {
        "from_element": "lowpass_tau",
        "from_port": 0,
        "to_element": "lowpass",
        "to_port": 1
      },
      {
        "from_element": "lowpass",
        "from_port": 0,
        "to_element": "recovered",
        "to_port": 0
      },
      {
        "from_element": "bias",
        "from_port": 0,
        "to_element": "recovered",
        "to_port": 1
      }
    ]
  },
  "probes": [
    {
      "name": "message",
