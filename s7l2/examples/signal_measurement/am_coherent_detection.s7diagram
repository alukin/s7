{
  "id": "am_coherent_detection",
  "dt": 0.0001,
  "document_kind": "s7.diagram",
  "diagram_version": 2,
  "sheet": {
    "orientation": "landscape",
    "width_mm": 1000,
    "height_mm": 450
  },
  "schema": {
    "name": "am_coherent_detection",
    "dt": 0.0001,
    "elements": [
      {
        "id": "message",
        "type": "AnalogOscillator",
        "params": {
          "amplitude": 1,
          "frequency_hz": 2,
          "sample_rate_hz": 10000
        }
      },
      {
        "id": "bias",
        "type": "Constant",
        "params": {
          "value": 1
        }
      },
      {
        "id": "envelope",
        "type": "Adder",
        "params": {
          "weights": [
            1,
            0.6
          ]
        }
      },
      {
        "id": "carrier",
        "type": "AnalogOscillator",
        "params": {
          "amplitude": 1,
          "frequency_hz": 100,
          "sample_rate_hz": 10000
        }
      },
      {
        "id": "am_signal",
        "type": "Multiply",
        "params": {}
      },
      {
        "id": "mixer",
        "type": "Multiply",
        "params": {}
      },
      {
        "id": "twice_mixer",
        "type": "Gain",
        "params": {
          "factor": 2
        }
      },
      {
        "id": "lowpass",
        "type": "FirstOrderLag",
        "params": {},
        "schema": {
          "name": "FirstOrderLag",
          "elements": [
            {
              "id": "difference",
              "type": "Adder",
              "params": {
                "weights": [
                  1,
                  -1
                ]
              }
            },
            {
              "id": "rate",
              "type": "Divider",
              "params": {}
            },
            {
              "id": "state",
              "type": "EulerIntegrator",
              "params": {
                "dt": 0.0001
              }
            }
          ],
          "connections": [
            {
              "from_element": "state",
              "from_port": 0,
              "to_element": "difference",
              "to_port": 1
            },
            {
              "from_element": "difference",
              "from_port": 0,
              "to_element": "rate",
              "to_port": 0
            },
            {
              "from_element": "rate",
              "from_port": 0,
              "to_element": "state",
              "to_port": 0
            }
          ],
          "exposed_inputs": [
            {
              "name": "input",
              "type": "F64",
              "element": "difference",
              "port": 0
            },
            {
              "name": "tau",
              "type": "F64",
              "element": "rate",
              "port": 1
            }
          ],
          "exposed_outputs": [
            {
              "name": "output",
              "type": "F64",
              "element": "state",
              "port": 0
            }
          ],
          "dt": 0.0001
        }
      },
      {
        "id": "lowpass_tau",
        "type": "Constant",
        "params": {
          "value": 0.02
        }
      },
      {
        "id": "recovered",
        "type": "Adder",
        "params": {
          "weights": [
            1.6666666666666667,
            -1.6666666666666667
          ]
        }
      }
    ],
    "connections": [
      {
        "from_element": "bias",
        "from_port": 0,
        "to_element": "envelope",
        "to_port": 0
      },
      {
        "from_element": "message",
        "from_port": 0,
        "to_element": "envelope",
        "to_port": 1
      },
      {
        "from_element": "envelope",
        "from_port": 0,
        "to_element": "am_signal",
        "to_port": 0
      },
      {
        "from_element": "carrier",
