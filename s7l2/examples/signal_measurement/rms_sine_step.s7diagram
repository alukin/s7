              "to_element": "state",
              "to_port": 0
            },
            {
              "from_element": "one",
              "from_port": 0,
              "to_element": "state",
              "to_port": 1
            },
            {
              "from_element": "zero",
              "from_port": 0,
              "to_element": "state",
              "to_port": 2
            },
            {
              "from_element": "zero",
              "from_port": 0,
              "to_element": "state",
              "to_port": 3
            },
            {
              "from_element": "state",
              "from_port": 0,
              "to_element": "root",
              "to_port": 0
            }
          ],
          "exposed_inputs": [
            {
              "name": "input",
              "type": "F64",
              "element": "input",
              "port": 0
            },
            {
              "name": "tau",
              "type": "F64",
              "element": "rate",
              "port": 1
            }
          ],
          "exposed_outputs": [
            {
              "name": "rms",
              "type": "F64",
              "element": "root",
              "port": 0
            }
          ],
          "dt": 0.0001
        }
      },
      {
        "id": "rms_tau",
        "type": "Constant",
        "params": {
          "value": 0.05
        }
      },
      {
        "id": "expected",
        "type": "Gain",
        "params": {
          "factor": 0.7071067811865475
        }
      }
    ],
    "connections": [
      {
        "from_element": "amplitude",
