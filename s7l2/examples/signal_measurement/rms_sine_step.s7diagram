  "schema": {
    "name": "rms_sine_step",
    "dt": 0.0001,
    "elements": [
      {
        "id": "amplitude",
        "type": "StepGenerator",
        "params": {
          "initial_value": 2,
          "final_value": 1,
          "sample_rate_hz": 10000.0,
          "start_sample": 10000
        }
      },
      {
        "id": "carrier",
        "type": "AnalogOscillator",
        "params": {
          "amplitude": 1,
          "frequency_hz": 50,
          "sample_rate_hz": 10000
        }
      },
      {
        "id": "signal",
        "type": "Multiply",
        "params": {}
      },
      {
        "id": "rms",
        "type": "RMSDetector",
        "params": {},
        "schema": {
          "name": "RMSDetector",
          "elements": [
            {
              "id": "input",
              "type": "Gain",
              "params": {
                "factor": 1
              }
            },
            {
              "id": "square",
              "type": "Multiply",
              "params": {}
            },
            {
              "id": "difference",
              "type": "Adder",
              "params": {
                "weights": [
                  1,
                  -1
                ]
              }
            },
            {
              "id": "rate",
              "type": "Divider",
              "params": {}
            },
            {
              "id": "state",
              "type": "ControlledIntegrator",
              "params": {
                "dt": 0.0001,
                "lower_limit": 0
              }
            },
            {
              "id": "one",
              "type": "Constant",
              "params": {
                "value": 1
              }
            },
            {
              "id": "zero",
              "type": "Constant",
              "params": {
                "value": 0
              }
            },
            {
              "id": "root",
              "type": "MathFunction",
              "params": {
                "function": "sqrt"
              }
            }
          ],
          "connections": [
            {
              "from_element": "input",
              "from_port": 0,
              "to_element": "square",
              "to_port": 0
            },
            {
              "from_element": "input",
              "from_port": 0,
              "to_element": "square",
              "to_port": 1
            },
            {
              "from_element": "square",
              "from_port": 0,
              "to_element": "difference",
              "to_port": 0
            },
            {
              "from_element": "state",
