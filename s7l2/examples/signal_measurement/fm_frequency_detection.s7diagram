{
  "id": "fm_frequency_detection",
  "dt": 0.0001,
  "document_kind": "s7.diagram",
  "diagram_version": 2,
  "sheet": {
    "orientation": "landscape",
    "width_mm": 1000,
    "height_mm": 450
  },
  "schema": {
    "name": "fm_frequency_detection",
    "dt": 0.0001,
    "elements": [
      {
        "id": "message",
        "type": "AnalogOscillator",
        "params": {
          "amplitude": 1,
          "frequency_hz": 2,
          "sample_rate_hz": 10000
        }
      },
      {
        "id": "carrier_frequency",
        "type": "Constant",
        "params": {
          "value": 100
        }
      },
      {
        "id": "frequency",
        "type": "Adder",
        "params": {
          "weights": [
            1,
            20
          ]
        }
      },
      {
        "id": "fm_signal",
        "type": "ControlledOscillator",
        "params": {
          "amplitude": 1,
          "sample_rate_hz": 10000,
          "phase": 0
        }
      },
      {
        "id": "meter",
        "type": "FrequencyMeter",
        "params": {
          "sample_rate_hz": 10000
        }
      },
      {
        "id": "raw_message",
        "type": "Adder",
        "params": {
          "weights": [
            0.05,
            -0.05
          ]
        }
      },
      {
        "id": "zero",
        "type": "Constant",
        "params": {
          "value": 0
        }
      },
      {
        "id": "valid_message",
        "type": "Switch",
        "params": {}
      },
      {
        "id": "lowpass",
        "type": "FirstOrderLag",
        "params": {},
        "schema": {
          "name": "FirstOrderLag",
          "elements": [
            {
              "id": "difference",
              "type": "Adder",
              "params": {
                "weights": [
                  1,
                  -1
                ]
              }
            },
            {
              "id": "rate",
              "type": "Divider",
              "params": {}
            },
            {
              "id": "state",
              "type": "EulerIntegrator",
              "params": {
                "dt": 0.0001
              }
            }
          ],
          "connections": [
            {
              "from_element": "state",
              "from_port": 0,
              "to_element": "difference",
              "to_port": 1
            },
            {
              "from_element": "difference",
              "from_port": 0,
              "to_element": "rate",
              "to_port": 0
            },
            {
              "from_element": "rate",
              "from_port": 0,
              "to_element": "state",
              "to_port": 0
            }
          ],
          "exposed_inputs": [
            {
              "name": "input",
              "type": "F64",
              "element": "difference",
              "port": 0
            },
            {
              "name": "tau",
              "type": "F64",
              "element": "rate",
              "port": 1
            }
          ],
          "exposed_outputs": [
            {
              "name": "output",
              "type": "F64",
              "element": "state",
              "port": 0
            }
          ],
          "dt": 0.0001
        }
      },
      {
        "id": "lowpass_tau",
        "type": "Constant",
        "params": {
          "value": 0.02
        }
      }
    ],
    "connections": [
      {
        "from_element": "carrier_frequency",
        "from_port": 0,
        "to_element": "frequency",
        "to_port": 0
      },
      {
        "from_element": "message",
        "from_port": 0,
        "to_element": "frequency",
        "to_port": 1
      },
      {
        "from_element": "frequency",
        "from_port": 0,
        "to_element": "fm_signal",
        "to_port": 0
      },
      {
        "from_element": "fm_signal",
        "from_port": 0,
        "to_element": "meter",
        "to_port": 0
      },
      {
        "from_element": "meter",
        "from_port": 0,
        "to_element": "raw_message",
        "to_port": 0
      },
      {
        "from_element": "carrier_frequency",
        "from_port": 0,
        "to_element": "raw_message",
        "to_port": 1
      },
      {
        "from_element": "zero",
        "from_port": 0,
        "to_element": "valid_message",
        "to_port": 0
      },
      {
        "from_element": "raw_message",
        "from_port": 0,
        "to_element": "valid_message",
        "to_port": 1
      },
      {
        "from_element": "meter",
        "from_port": 1,
        "to_element": "valid_message",
        "to_port": 2
      },
      {
        "from_element": "valid_message",
        "from_port": 0,
        "to_element": "lowpass",
        "to_port": 0
      },
      {
        "from_element": "lowpass_tau",
        "from_port": 0,
        "to_element": "lowpass",
        "to_port": 1
      }
    ]
  },
  "probes": [
    {
      "name": "message",
      "element": "message",
      "port": 0,
      "unit": "1"
    },
    {
      "name": "raw_detected",
      "element": "valid_message",
      "port": 0,
      "unit": "1"
    },
    {
      "name": "smoothed",
      "element": "lowpass",
      "port": 0,
      "unit": "1"
    },
    {
      "name": "command_Hz",
      "element": "frequency",
      "port": 0,
      "unit": "Hz"
    },
    {
      "name": "measured_Hz",
      "element": "meter",
      "port": 0,
      "unit": "Hz"
    },
    {
      "name": "fm_V",
      "element": "fm_signal",
      "port": 0,
      "unit": "V"
    },
    {
      "name": "valid",
      "element": "meter",
      "port": 1,
      "unit": "1"
    }
  ],
  "diagram": {
    "grid": {
      "step": 20,
