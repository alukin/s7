    "text_frames": [
      {
        "id": "equation_notes",
        "position": [
          3,
          74
        ],
        "params": {
          "text": "FULL NONLINEAR DOUBLE PENDULUM  |  m1=m2=1 kg, l1=l2=1 m, g=9.81 m/s²\nAngles are measured from the downward vertical; δ = θ1 − θ2.\nα1 = [m2 g sinθ2 cosδ − m2 sinδ(l1 ω1² cosδ + l2 ω2²) − (m1+m2)g sinθ1] / [l1(m1+m2 sin²δ)]\nα2 = [(m1+m2)(l1 ω1² sinδ − g sinθ2 + g sinθ1 cosδ) + m2 l2 ω2² sinδ cosδ] / [l2(m1+m2 sin²δ)]\nForward Euler integration, dt=1 ms. Initial state: θ1=2 rad, θ2=1.5 rad, ω1=ω2=0. Scope plots both angles and angular velocities.",
          "text_color": "#202020",
          "line_color": "#58738a",
          "fill_color": "#eef6fb",
          "font_family": "Sans Serif",
          "font_size": 10,
          "width": 980.0,
          "height": 170.0
        }
      }
    ]
  }
