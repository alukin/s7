@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# CONFIG: Boost's own package, not CMake's deprecated FindBoost module.
find_dependency(Boost 1.75 CONFIG COMPONENTS json OPTIONAL_COMPONENTS system)
if (NOT TARGET Boost::system)
    # Boost >= 1.89 makes Boost.System header-only and drops its CMake component.
    add_library(Boost::system INTERFACE IMPORTED)
    target_link_libraries(Boost::system INTERFACE Boost::headers)
endif()
find_dependency(ZLIB)

include("${CMAKE_CURRENT_LIST_DIR}/s7coreTargets.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/S7EmbedMetadata.cmake")
check_required_components(s7core)
