    {
      "type_name": "SurfaceGaussian",
      "display_name": "Surface: Gaussian",
      "description": "exp(\u2212x\u00b2\u2212y\u00b2); editable stateless F64 schema, inputs x/y. ",
      "category": "schema_elements",
