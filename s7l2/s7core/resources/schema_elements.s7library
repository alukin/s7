{
  "document_kind": "s7.element_library",
  "name": "s7_standard_schema_elements",
  "elements": [
    {
      "type_name": "PhaseDifference",
      "display_name": "PhaseDifference",
      "description": "Subtracts phase_b from phase_a and wraps the result into [-pi,pi) radians. Both exposed inputs and the difference output are F64 phase signals. Combinational network; no state or instance JSON parameters. Tune the internal PhaseWrap for a different interval.",
      "category": "schema_elements",
      "version": "1.0.0",
      "schema": {
        "name": "PhaseDifference",
        "elements": [
          {
            "id": "difference",
            "type": "Adder",
            "params": {
              "weights": [
                1,
                -1
              ]
            }
          },
          {
            "id": "wrap",
            "type": "PhaseWrap",
            "params": {}
          }
        ],
        "connections": [
          {
            "from_element": "difference",
            "from_port": 0,
            "to_element": "wrap",
            "to_port": 0
          }
        ],
        "exposed_inputs": [
          {
            "name": "phase_a",
            "type": "F64",
            "element": "difference",
            "port": 0
          },
          {
            "name": "phase_b",
            "type": "F64",
            "element": "difference",
            "port": 1
          }
        ],
        "exposed_outputs": [
          {
            "name": "difference",
            "type": "F64",
            "element": "wrap",
            "port": 0
          }
        ],
        "dt": 0.001
      }
    },
    {
      "type_name": "FirstOrderLag",
      "display_name": "FirstOrderLag",
      "description": "Smooths input with a first-order lag: tau*y'=input-y. Exposed F64 signals: input (signal units), tau (strictly positive seconds), output (same units as input). tau is a signal input, not a JSON parameter. Internal forward-Euler state starts at 0; choose dt small relative to tau (dt/tau < 2 for constant-tau stability). Default dt=0.001 s (1 kHz). No instance JSON parameters; tune internal state.initial_value in the nested editor.",
      "category": "schema_elements",
      "version": "1.0.0",
      "schema": {
        "name": "FirstOrderLag",
        "elements": [
          {
            "id": "difference",
            "type": "Adder",
            "params": {
              "weights": [
                1,
                -1
              ]
            }
          },
          {
            "id": "rate",
            "type": "Divider",
            "params": {}
          },
          {
            "id": "state",
            "type": "EulerIntegrator",
            "params": {
              "dt": 0.001
            }
          }
        ],
        "connections": [
          {
            "from_element": "state",
            "from_port": 0,
            "to_element": "difference",
            "to_port": 1
          },
          {
            "from_element": "difference",
            "from_port": 0,
            "to_element": "rate",
            "to_port": 0
          },
          {
            "from_element": "rate",
            "from_port": 0,
            "to_element": "state",
            "to_port": 0
          }
        ],
        "exposed_inputs": [
          {
            "name": "input",
            "type": "F64",
            "element": "difference",
            "port": 0
          },
          {
            "name": "tau",
            "type": "F64",
            "element": "rate",
            "port": 1
          }
        ],
        "exposed_outputs": [
          {
            "name": "output",
            "type": "F64",
            "element": "state",
            "port": 0
          }
        ],
        "dt": 0.001
      }
    },
    {
      "type_name": "RMSDetector",
      "display_name": "RMSDetector",
      "description": "Estimates an exponential root-mean-square level: tau*q'=input^2-q; rms=sqrt(q). F64 input and rms use the same signal units; tau is an exposed positive time-constant signal in seconds, not a JSON parameter. Internal q starts at 0 and is limited to nonnegative values; tau >= dt is recommended. Default dt=0.001 s (1 kHz). No instance JSON parameters; the nested editor exposes the state and limiter settings.",
      "category": "schema_elements",
      "version": "1.0.0",
      "schema": {
        "name": "RMSDetector",
        "elements": [
          {
            "id": "input",
            "type": "Gain",
            "params": {
              "factor": 1
            }
          },
          {
            "id": "square",
            "type": "Multiply",
            "params": {}
          },
          {
            "id": "difference",
            "type": "Adder",
            "params": {
              "weights": [
                1,
                -1
              ]
            }
          },
          {
            "id": "rate",
            "type": "Divider",
            "params": {}
          },
          {
            "id": "state",
            "type": "ControlledIntegrator",
            "params": {
              "dt": 0.001,
              "lower_limit": 0
            }
          },
          {
            "id": "one",
            "type": "Constant",
            "params": {
              "value": 1
            }
          },
          {
            "id": "zero",
            "type": "Constant",
            "params": {
              "value": 0
            }
          },
          {
            "id": "root",
            "type": "MathFunction",
            "params": {
              "function": "sqrt"
            }
          }
        ],
        "connections": [
          {
            "from_element": "input",
            "from_port": 0,
            "to_element": "square",
            "to_port": 0
          },
          {
            "from_element": "input",
            "from_port": 0,
            "to_element": "square",
            "to_port": 1
          },
          {
            "from_element": "square",
            "from_port": 0,
            "to_element": "difference",
            "to_port": 0
          },
          {
            "from_element": "state",
            "from_port": 0,
            "to_element": "difference",
            "to_port": 1
          },
          {
            "from_element": "difference",
            "from_port": 0,
            "to_element": "rate",
            "to_port": 0
          },
          {
            "from_element": "rate",
            "from_port": 0,
            "to_element": "state",
            "to_port": 0
          },
          {
            "from_element": "one",
            "from_port": 0,
            "to_element": "state",
            "to_port": 1
          },
          {
            "from_element": "zero",
            "from_port": 0,
            "to_element": "state",
            "to_port": 2
          },
          {
            "from_element": "zero",
            "from_port": 0,
            "to_element": "state",
            "to_port": 3
          },
          {
            "from_element": "state",
            "from_port": 0,
            "to_element": "root",
            "to_port": 0
          }
        ],
        "exposed_inputs": [
          {
            "name": "input",
            "type": "F64",
            "element": "input",
            "port": 0
          },
          {
            "name": "tau",
            "type": "F64",
            "element": "rate",
            "port": 1
          }
        ],
        "exposed_outputs": [
          {
            "name": "rms",
            "type": "F64",
            "element": "root",
            "port": 0
          }
        ],
        "dt": 0.001
      }
    },
    {
      "type_name": "PIController",
      "display_name": "PIController",
      "description": "Controls from an error signal using proportional and integral paths. Exposed F64 inputs: error, kp (output/error units), ki (output/error/second). Gains are signals, not JSON parameters. control is limited to [-1,1]; unlimited exposes the pre-limit sum. Integral state starts at 0 with forward Euler; back-calculation gain is 10/s. Default dt=0.001 s (1 kHz). No instance JSON parameters; tune internal limits, initial state and tracking weight in the nested editor.",
      "category": "schema_elements",
      "version": "1.0.0",
      "schema": {
        "name": "PIController",
        "elements": [
          {
            "id": "error",
            "type": "Gain",
            "params": {
              "factor": 1
            }
          },
          {
            "id": "p",
            "type": "Multiply",
            "params": {}
          },
          {
            "id": "i_gain",
            "type": "Multiply",
            "params": {}
          },
          {
            "id": "i_rate",
            "type": "Adder",
            "params": {
              "weights": [
                1,
                10
              ]
            }
          },
          {
            "id": "i_state",
            "type": "EulerIntegrator",
            "params": {
              "dt": 0.001
            }
          },
          {
            "id": "sum",
            "type": "Adder",
            "params": {
              "weights": [
                1,
                1
              ]
            }
          },
          {
            "id": "limit",
            "type": "Saturation",
            "params": {
              "lower_limit": -1,
              "upper_limit": 1
            }
          },
          {
            "id": "tracking",
            "type": "Adder",
            "params": {
              "weights": [
                1,
                -1
              ]
            }
          }
        ],
        "connections": [
          {
            "from_element": "error",
            "from_port": 0,
            "to_element": "p",
            "to_port": 0
          },
          {
            "from_element": "error",
            "from_port": 0,
            "to_element": "i_gain",
            "to_port": 0
          },
          {
            "from_element": "i_gain",
            "from_port": 0,
            "to_element": "i_rate",
            "to_port": 0
          },
          {
            "from_element": "tracking",
            "from_port": 0,
            "to_element": "i_rate",
            "to_port": 1
          },
          {
            "from_element": "i_rate",
            "from_port": 0,
            "to_element": "i_state",
            "to_port": 0
          },
          {
            "from_element": "p",
            "from_port": 0,
            "to_element": "sum",
            "to_port": 0
          },
          {
            "from_element": "i_state",
            "from_port": 0,
            "to_element": "sum",
            "to_port": 1
          },
          {
            "from_element": "sum",
            "from_port": 0,
            "to_element": "limit",
            "to_port": 0
          },
          {
            "from_element": "limit",
            "from_port": 0,
            "to_element": "tracking",
            "to_port": 0
          },
          {
            "from_element": "sum",
            "from_port": 0,
            "to_element": "tracking",
            "to_port": 1
          }
        ],
        "exposed_inputs": [
          {
            "name": "error",
            "type": "F64",
            "element": "error",
            "port": 0
          },
          {
            "name": "kp",
            "type": "F64",
            "element": "p",
            "port": 1
          },
          {
            "name": "ki",
            "type": "F64",
            "element": "i_gain",
            "port": 1
          }
        ],
        "exposed_outputs": [
          {
            "name": "control",
            "type": "F64",
            "element": "limit",
            "port": 0
          },
          {
            "name": "unlimited",
            "type": "F64",
            "element": "sum",
            "port": 0
          }
        ],
        "dt": 0.001
      }
    },
    {
      "type_name": "PIDController",
      "display_name": "PIDController",
      "description": "Controls reference minus measurement using proportional, integral and filtered derivative-on-measurement paths. Exposed F64 inputs: reference and measurement (same units), kp (output/input units), ki (output/input/second), kd (output*second/input), tau (positive derivative-filter seconds). Gains and tau are signals, not JSON parameters. control is limited to [-1,1]; unlimited exposes the pre-limit sum. Integral/filter states start at 0 with forward Euler; back-calculation gain is 10/s. Default dt=0.001 s (1 kHz); choose dt small relative to tau. No instance JSON parameters; tune internal limits, tracking and initial states in the nested editor.",
      "category": "schema_elements",
      "version": "1.0.0",
      "schema": {
        "name": "PIDController",
        "elements": [
          {
            "id": "error",
            "type": "Adder",
            "params": {
              "weights": [
                1,
                -1
              ]
            }
          },
          {
            "id": "measurement",
            "type": "Gain",
            "params": {
              "factor": 1
            }
          },
          {
            "id": "p",
            "type": "Multiply",
            "params": {}
          },
          {
            "id": "i_gain",
            "type": "Multiply",
            "params": {}
          },
          {
            "id": "i_rate",
            "type": "Adder",
            "params": {
              "weights": [
                1,
                10
              ]
            }
          },
          {
            "id": "i_state",
            "type": "EulerIntegrator",
            "params": {
              "dt": 0.001
            }
          },
          {
            "id": "sum",
            "type": "Adder",
            "params": {
              "weights": [
                1,
                1,
                -1
              ]
            }
          },
          {
            "id": "limit",
            "type": "Saturation",
            "params": {
              "lower_limit": -1,
              "upper_limit": 1
            }
          },
          {
            "id": "tracking",
            "type": "Adder",
            "params": {
              "weights": [
                1,
                -1
              ]
            }
          },
          {
            "id": "filter_difference",
            "type": "Adder",
            "params": {
              "weights": [
                1,
                -1
              ]
            }
          },
          {
            "id": "filter_rate",
            "type": "Divider",
            "params": {}
          },
          {
            "id": "filter_state",
            "type": "EulerIntegrator",
            "params": {
              "dt": 0.001
            }
          },
          {
            "id": "derivative",
            "type": "Multiply",
            "params": {}
          }
        ],
        "connections": [
          {
            "from_element": "measurement",
            "from_port": 0,
            "to_element": "error",
            "to_port": 1
          },
          {
            "from_element": "error",
            "from_port": 0,
            "to_element": "p",
            "to_port": 0
          },
          {
            "from_element": "error",
            "from_port": 0,
            "to_element": "i_gain",
            "to_port": 0
          },
          {
            "from_element": "i_gain",
            "from_port": 0,
            "to_element": "i_rate",
            "to_port": 0
          },
          {
            "from_element": "tracking",
            "from_port": 0,
            "to_element": "i_rate",
            "to_port": 1
          },
          {
            "from_element": "i_rate",
            "from_port": 0,
            "to_element": "i_state",
            "to_port": 0
          },
          {
            "from_element": "p",
            "from_port": 0,
            "to_element": "sum",
            "to_port": 0
          },
          {
            "from_element": "i_state",
            "from_port": 0,
            "to_element": "sum",
            "to_port": 1
          },
          {
            "from_element": "sum",
            "from_port": 0,
            "to_element": "limit",
            "to_port": 0
          },
          {
            "from_element": "limit",
            "from_port": 0,
            "to_element": "tracking",
            "to_port": 0
          },
          {
            "from_element": "sum",
            "from_port": 0,
            "to_element": "tracking",
            "to_port": 1
          },
          {
            "from_element": "measurement",
            "from_port": 0,
            "to_element": "filter_difference",
            "to_port": 0
          },
          {
            "from_element": "filter_state",
            "from_port": 0,
            "to_element": "filter_difference",
            "to_port": 1
          },
          {
            "from_element": "filter_difference",
            "from_port": 0,
            "to_element": "filter_rate",
            "to_port": 0
          },
          {
            "from_element": "filter_rate",
            "from_port": 0,
            "to_element": "filter_state",
            "to_port": 0
          },
          {
            "from_element": "filter_rate",
            "from_port": 0,
            "to_element": "derivative",
            "to_port": 0
          },
          {
            "from_element": "derivative",
            "from_port": 0,
            "to_element": "sum",
            "to_port": 2
          }
        ],
        "exposed_inputs": [
          {
            "name": "reference",
            "type": "F64",
            "element": "error",
            "port": 0
          },
          {
            "name": "measurement",
            "type": "F64",
            "element": "measurement",
            "port": 0
          },
          {
            "name": "kp",
            "type": "F64",
            "element": "p",
            "port": 1
          },
          {
            "name": "ki",
            "type": "F64",
            "element": "i_gain",
            "port": 1
          },
          {
            "name": "kd",
            "type": "F64",
            "element": "derivative",
            "port": 1
          },
          {
            "name": "tau",
            "type": "F64",
            "element": "filter_rate",
            "port": 1
          }
        ],
        "exposed_outputs": [
          {
            "name": "control",
            "type": "F64",
            "element": "limit",
            "port": 0
          },
          {
            "name": "unlimited",
            "type": "F64",
            "element": "sum",
            "port": 0
          }
        ],
        "dt": 0.001
      }
    },
    {
      "type_name": "SurfacePlane",
      "display_name": "Surface: Plane",
