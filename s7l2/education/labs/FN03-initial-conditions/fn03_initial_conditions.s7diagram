        "params": {
          "initial_value": 2
        }
      },
      {
        "id": "total_gain",
        "type": "Gain",
        "params": {
          "factor": 0.5
        }
      },
      {
        "id": "natural",
        "type": "Adder",
        "params": {
          "weights": [
            1,
            1
          ]
        }
