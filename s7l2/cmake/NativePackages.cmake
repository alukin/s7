# Binary packages are built on their target distribution, using its libraries.
if(NOT CMAKE_INSTALL_PREFIX STREQUAL "/usr")
    message(FATAL_ERROR "S7_NATIVE_PACKAGES requires -DCMAKE_INSTALL_PREFIX=/usr")
endif()
if(NOT S7_BUILD_SDR)
    message(FATAL_ERROR "Native Linux hardware packages require S7_BUILD_SDR=ON")
endif()
foreach(backend PORTAUDIO PIPEWIRE SOAPYSDR)
    get_property(available GLOBAL PROPERTY S7_HAVE_${backend})
    if(NOT available OR NOT S7_${backend} STREQUAL "ON")
        message(FATAL_ERROR "Native hardware packages require S7_${backend}=ON and its development files")
    endif()
endforeach()
get_target_property(frame_codecs s7transport COMPILE_DEFINITIONS)
foreach(codec S7_FRAMES_LZ4 S7_FRAMES_ZSTD)
    if(NOT codec IN_LIST frame_codecs)
        message(FATAL_ERROR "Native packages require both LZ4 and static Zstandard frame codecs")
    endif()
endforeach()

file(STRINGS /etc/os-release os_release REGEX "^(ID|VERSION_ID)=")
foreach(line IN LISTS os_release)
    if(line MATCHES "^ID=\"?([^\"]+)\"?$")
        set(distro "${CMAKE_MATCH_1}")
    elseif(line MATCHES "^VERSION_ID=\"?([^\"]+)\"?$")
        set(distro_version "${CMAKE_MATCH_1}")
    endif()
endforeach()
if(NOT distro MATCHES "^(fedora|ubuntu)$")
    message(FATAL_ERROR "Native package metadata currently supports Fedora and Ubuntu")
endif()

set(S7_PACKAGE_RELEASE "1" CACHE STRING "Distribution package revision")
set(CPACK_PACKAGE_NAME s7)
set(CPACK_PACKAGE_VENDOR "S7 contributors")
set(CPACK_PACKAGE_CONTACT "Oleksiy Lukin <alukin@users.noreply.github.com>")
set(CPACK_PACKAGE_HOMEPAGE_URL "https://github.com/alukin/s7")
set(CPACK_PACKAGE_DESCRIPTION_SUMMARY "Causal graph runtime and development tools")
set(CPACK_PACKAGE_VERSION ${PROJECT_VERSION})
set(CPACK_PACKAGE_VERSION_MAJOR ${PROJECT_VERSION_MAJOR})
set(CPACK_PACKAGE_VERSION_MINOR ${PROJECT_VERSION_MINOR})
set(CPACK_PACKAGE_VERSION_PATCH ${PROJECT_VERSION_PATCH})
set(CPACK_RESOURCE_FILE_LICENSE "${PROJECT_SOURCE_DIR}/../LICENSE")
set(CPACK_PACKAGING_INSTALL_PREFIX /usr)
set(CPACK_PACKAGE_RELOCATABLE OFF)
set(CPACK_STRIP_FILES ON)
set(CPACK_COMPONENTS_GROUPING IGNORE)
set(CPACK_COMPONENTS_ALL s7libs s7runtime s7hardware s7sdk)
if(S7_NATIVE_ANALYSIS_PREFIX)
    list(APPEND CPACK_COMPONENTS_ALL s7analysis)
    set(CPACK_COMPONENT_S7ANALYSIS_DEPENDS s7libs)
endif()
if(S7_BUILD_STUDIO)
    list(APPEND CPACK_COMPONENTS_ALL s7studio)
endif()
set(CPACK_COMPONENT_S7RUNTIME_DEPENDS s7libs)
set(CPACK_COMPONENT_S7HARDWARE_DEPENDS s7libs)
set(CPACK_COMPONENT_S7SDK_DEPENDS s7libs s7hardware)
set(CPACK_COMPONENT_S7STUDIO_DEPENDS s7runtime)

set(CPACK_COMPONENT_S7LIBS_DESCRIPTION "S7 shared causal graph library and schema elements")
set(CPACK_COMPONENT_S7RUNTIME_DESCRIPTION "Headless S7 runtime, control CLI, examples and noise plugin")
set(CPACK_COMPONENT_S7HARDWARE_DESCRIPTION "S7 hardware runner, SDK libraries, audio and SDR element plugins")
set(CPACK_COMPONENT_S7SDK_DESCRIPTION "S7 headers and CMake packages for external elements and hardware providers")
set(CPACK_COMPONENT_S7STUDIO_DESCRIPTION "S7 diagram editor, local simulation and observation viewers")
set(CPACK_COMPONENT_S7ANALYSIS_DESCRIPTION "Out-of-tree S7 spectral and wavelet element plugins")
foreach(component s7libs s7runtime s7hardware s7sdk s7studio s7analysis)
    string(TOUPPER ${component} upper)
    set(CPACK_RPM_${upper}_PACKAGE_SUMMARY "${CPACK_COMPONENT_${upper}_DESCRIPTION}")
    set(CPACK_RPM_${upper}_PACKAGE_DESCRIPTION "${CPACK_COMPONENT_${upper}_DESCRIPTION}")
    set(CPACK_DEBIAN_${upper}_DESCRIPTION "${CPACK_COMPONENT_${upper}_DESCRIPTION}")
endforeach()

if(distro STREQUAL "fedora")
    set(CPACK_GENERATOR RPM)
    set(CPACK_RPM_COMPONENT_INSTALL ON)
    set(CPACK_RPM_FILE_NAME RPM-DEFAULT)
    set(CPACK_RPM_PACKAGE_RELEASE "${S7_PACKAGE_RELEASE}.fc${distro_version}")
    set(CPACK_RPM_PACKAGE_LICENSE "LGPL-3.0-or-later AND GPL-3.0-or-later AND BSD-3-Clause AND CC-BY-4.0 AND CC0-1.0")
    set(CPACK_RPM_PACKAGE_GROUP "Development/Tools")
    set(CPACK_RPM_PACKAGE_AUTOREQPROV ON)
    set(CPACK_RPM_S7LIBS_PACKAGE_NAME s7-libs)
    set(CPACK_RPM_S7RUNTIME_PACKAGE_NAME s7-runtime)
    set(CPACK_RPM_S7HARDWARE_PACKAGE_NAME s7-hardware)
    set(CPACK_RPM_S7SDK_PACKAGE_NAME s7-devel)
    set(CPACK_RPM_S7STUDIO_PACKAGE_NAME s7-studio)
    set(CPACK_RPM_S7ANALYSIS_PACKAGE_NAME s7-analysis)
    set(exact "${PROJECT_VERSION}-${CPACK_RPM_PACKAGE_RELEASE}")
    set(CPACK_RPM_S7RUNTIME_PACKAGE_REQUIRES "s7-libs = ${exact}")
    set(CPACK_RPM_S7HARDWARE_PACKAGE_REQUIRES "s7-libs = ${exact}")
    set(CPACK_RPM_S7ANALYSIS_PACKAGE_REQUIRES "s7-libs = ${exact}")
    set(CPACK_RPM_S7SDK_PACKAGE_REQUIRES "s7-libs = ${exact}, s7-hardware = ${exact}, boost-devel, zlib-ng-compat-devel, cmake, make, gcc-c++ >= 15")
    set(CPACK_RPM_S7STUDIO_PACKAGE_REQUIRES "s7-runtime = ${exact}, qt6-qtdeclarative, qt6-qtgraphs, qt6-qtquick3d, qt6-qtsvg, qt6-qtwayland, dejavu-sans-fonts")
    set(CPACK_RPM_S7STUDIO_PACKAGE_SUGGESTS "s7-hardware = ${exact}")
    set(CPACK_RPM_S7STUDIO_PACKAGE_LICENSE "GPL-3.0-or-later AND BSD-3-Clause AND MIT AND Zlib")
    set(CPACK_RPM_S7ANALYSIS_PACKAGE_LICENSE "MIT-0 AND GPL-2.0-or-later")
    # Do not claim ownership of distribution-managed library/application directories.
    list(APPEND CPACK_RPM_EXCLUDE_FROM_AUTO_FILELIST_ADDITION
        /usr/share/licenses /usr/share/applications /usr/share/icons
        /usr/share/icons/hicolor /usr/share/icons/hicolor/scalable /usr/share/icons/hicolor/scalable/apps)
else()
    set(CPACK_GENERATOR DEB)
    set(CPACK_DEB_COMPONENT_INSTALL ON)
    set(CPACK_DEBIAN_ENABLE_COMPONENT_DEPENDS ON)
    set(CPACK_DEBIAN_FILE_NAME DEB-DEFAULT)
    set(CPACK_DEBIAN_PACKAGE_RELEASE "${S7_PACKAGE_RELEASE}ubuntu${distro_version}")
    set(CPACK_DEBIAN_PACKAGE_SECTION science)
    set(CPACK_DEBIAN_PACKAGE_SHLIBDEPS ON)
    set(CPACK_DEBIAN_PACKAGE_SHLIBDEPS_PRIVATE_DIRS
        "${PROJECT_BINARY_DIR}/s7core;${PROJECT_BINARY_DIR}/s7hardware;${PROJECT_BINARY_DIR}/s7audio;${PROJECT_BINARY_DIR}/s7sdr")
    set(CPACK_DEBIAN_S7LIBS_PACKAGE_NAME s7-libs)
    set(CPACK_DEBIAN_S7RUNTIME_PACKAGE_NAME s7-runtime)
    set(CPACK_DEBIAN_S7HARDWARE_PACKAGE_NAME s7-hardware)
    set(CPACK_DEBIAN_S7SDK_PACKAGE_NAME s7-dev)
    set(CPACK_DEBIAN_S7STUDIO_PACKAGE_NAME s7-studio)
    set(CPACK_DEBIAN_S7ANALYSIS_PACKAGE_NAME s7-analysis)
    set(CPACK_DEBIAN_S7LIBS_PACKAGE_GENERATE_SHLIBS ON)
    set(CPACK_DEBIAN_S7HARDWARE_PACKAGE_GENERATE_SHLIBS ON)
    set(CPACK_DEBIAN_S7SDK_PACKAGE_DEPENDS "libboost-json-dev, libboost-dev, zlib1g-dev, cmake, make, g++ (>= 15)")
    # QML imports and Qt platform/image plugins are not ELF link dependencies.
    set(CPACK_DEBIAN_S7STUDIO_PACKAGE_DEPENDS "qml6-module-qtquick, qml6-module-qtquick-window, qml6-module-qtqml-workerscript, qml6-module-qtgraphs, qml6-module-qtquick3d, qml6-module-qtquick3d-helpers, qt6-qpa-plugins, qt6-wayland, libqt6svg6, fonts-dejavu-core")
    set(CPACK_DEBIAN_S7STUDIO_PACKAGE_RECOMMENDS "s7-hardware")
    set(CPACK_DEBIAN_S7SDK_PACKAGE_SECTION libdevel)
endif()
include(CPack)
