#!/usr/bin/env bash
# Cross-builds S7 for 64-bit Windows on Linux in build-win/ (build-win-release/
# with --release): Clang 22 against the MSYS2 sysroot, tests under Wine
# (docs/WINDOWS_BUILD.md). Fetches the sysroot on the first run.
#
# Usage: ./build_for_windows [--release] [--no-studio] [--test] [--package]
#   --release    optimized build in build-win-release/ (test assertions remain enabled)
#   --no-studio  skip s7studio (no Qt needed)
#   --test       run the tests under Wine after building
#   --package    collect the programs and their DLLs into dist/s7-windows/ (implies --release)
# Set S7_QT_HOST_PATH when the host Qt tools are outside /usr (e.g. Fedora).
# Dependencies: tools/install_deps_ubuntu.sh --windows.

# SPDX-FileCopyrightText: Oleksiy Lukin and S7 contributors
# SPDX-License-Identifier: GPL-3.0-or-later

set -euo pipefail
cd "$(dirname "$0")"

BUILD=build-win
ARGS=(-DS7_BUILD_STUDIO=ON)
FETCH=()
FRESH=()
TEST=0
PACKAGE=0
for arg in "$@"; do
    case "$arg" in
        --release) BUILD=build-win-release ;;
        --no-studio) ARGS+=(-DS7_BUILD_STUDIO=OFF); FETCH+=(--no-studio) ;;
        --test) TEST=1 ;;
        --package) PACKAGE=1; BUILD=build-win-release ;;
        -h|--help) awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$0"; exit 0 ;;
        *) echo "Unknown option: $arg (see --help)" >&2; exit 2 ;;
    esac
done
[ "$BUILD" = build-win-release ] && ARGS+=(-DCMAKE_BUILD_TYPE=Release)
HOST_QT_PATH="${S7_QT_HOST_PATH:-}"
if [[ -z "$HOST_QT_PATH" && -x /usr/lib64/qt6/libexec/moc ]]; then
    HOST_QT_PATH=/usr/lib64/qt6
fi
if [[ -n "$HOST_QT_PATH" ]]; then
    ARGS+=(-DS7_QT_HOST_PATH="$HOST_QT_PATH")
fi

SYSROOT="${S7_MINGW_SYSROOT:-$HOME/.cache/s7/msys2-ucrt64}"
if [ ! -d "$SYSROOT/include/c++" ]; then
    tools/windows/fetch_msys2_sysroot.py "$SYSROOT" "${FETCH[@]}"
fi

RECONFIGURE=0
if [ -f "$BUILD/CMakeCache.txt" ]; then
    # A build tree moved from another Linux host can retain tool paths from
    # that host in CMake's generated compiler files, even after CMAKE_AR is
    # changed in the cache. Reconfigure it from scratch if an archiver vanished.
    for compiler_file in "$BUILD"/CMakeFiles/*/CMakeCXXCompiler.cmake "$BUILD"/CMakeFiles/*/CMakeCCompiler.cmake; do
        [ -f "$compiler_file" ] || continue
        for tool in $(sed -n 's/^set(CMAKE_\(AR\|RANLIB\) "\([^"]*\)").*/\2/p' "$compiler_file"); do
            if [[ "$tool" == */* ]]; then
                [ -x "$tool" ] || RECONFIGURE=1
            else
                command -v "$tool" > /dev/null || RECONFIGURE=1
            fi
        done
    done
fi
if [ ! -f "$BUILD/CMakeCache.txt" ] || (( RECONFIGURE )); then
    ARGS+=(-G Ninja --toolchain cmake/toolchains/x86_64-w64-mingw32-clang.cmake -DS7_MINGW_SYSROOT="$SYSROOT")
fi
if (( RECONFIGURE )); then
    if cmake --help | grep -q -- '--fresh'; then
        FRESH=(--fresh)
    else
        cmake -E rm -rf "$BUILD/CMakeFiles"
        cmake -E rm -f "$BUILD/CMakeCache.txt"
    fi
fi
cmake "${FRESH[@]}" -S . -B "$BUILD" "${ARGS[@]}"
cmake --build "$BUILD" --parallel
if (( TEST )); then
    cmake --build "$BUILD" --target build-tests --parallel "$(nproc)"
    ctest --test-dir "$BUILD" --output-on-failure --parallel "$(nproc)"
fi
if (( PACKAGE )); then
    tools/windows/package.sh "$BUILD" dist/s7-windows
fi
echo "Built in $BUILD/. Run programs with ./run_on_wine$( [ "$BUILD" = build-win ] || echo ' --release') <program>."
