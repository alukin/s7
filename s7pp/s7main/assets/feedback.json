{
  "id":  "feedback_example",
  "dt":  1e-9,
  "nodes": [
    {
      "id":     "c1",
      "type":   "Constant",
      "params": { "value": 1.0 }
    },
    {
      "id":     "sum1",
      "type":   "Sum",
      "params": { "w0": 1.0, "w1": 1.0 }
    },
    {
      "id":     "int1",
      "type":   "Integrator",
      "params": { "init_state": 0.0 }
    }
  ],
  "nets": [
    {
      "name": "n_c1_to_sum1",
      "connections": [
        { "node": "c1", "connector": "out0" },
        { "node": "sum1", "connector": "in0" }
      ]
    },
    {
      "name": "n_int1_feedback",
      "connections": [
        { "node": "int1", "connector": "out0" },
        { "node": "sum1", "connector": "in1" }
      ]
    },
    {
      "name": "n_sum1_to_int1",
      "connections": [
        { "node": "sum1", "connector": "out0" },
        { "node": "int1", "connector": "in0" }
      ]
    }
  ]
}

