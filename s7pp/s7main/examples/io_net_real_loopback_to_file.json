{
  "id": "io_net_real_loopback_to_file",
  "dt": 0.001,
  "nodes": [
    {
      "id": "c1",
      "type": "Constant",
      "params": {
        "value": 2.5
      }
    },
    {
      "id": "net_sink",
      "type": "RealNetSink",
      "params": {
        "num_channels": 1,
        "queue_capacity": 64,
        "zero_on_underrun": 1
      }
    },
    {
      "id": "net_source",
      "type": "RealNetSource",
      "params": {
        "num_channels": 1,
        "queue_capacity": 64,
        "zero_on_underrun": 1
      }
    },
    {
      "id": "file_sink",
      "type": "RealFileSink",
      "params": {
        "num_channels": 1,
        "sample_rate_hz": 1000.0,
        "encoding": 0
      }
    }
  ],
  "nets": [
    {
      "name": "n_const_to_net_sink",
      "connections": [
        { "node": "c1", "connector": "out0" },
        { "node": "net_sink", "connector": "in0" }
      ]
    },
    {
      "name": "n_net_source_to_file_sink",
      "connections": [
        { "node": "net_source", "connector": "out0" },
        { "node": "file_sink", "connector": "in0" }
      ]
    }
  ]
}

