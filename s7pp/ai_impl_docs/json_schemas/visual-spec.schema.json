{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://s7.example/schemas/visual-spec.schema.json",
  "title": "S7 Visual Library Spec v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "display_name", "shape"],
  "properties": {
    "type": {
      "type": "string",
      "minLength": 1
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "string",
      "minLength": 1
    },
    "shape": {
      "type": "string",
      "enum": ["rect", "round_rect", "hex", "diamond", "custom"]
    },
    "icon": {
      "type": "string",
      "description": "Icon asset path or identifier"
    },
    "palette_icon": {
      "type": "string",
      "description": "Palette-specific icon asset path or identifier"
    },
    "size": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "description": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "node_style": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "fill": { "type": "string" },
        "stroke": { "type": "string" },
        "stroke_width": { "type": "number", "minimum": 0 },
        "corner_radius": { "type": "number", "minimum": 0 },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "port_style": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "input_color": { "type": "string" },
        "output_color": { "type": "string" },
        "port_radius": { "type": "number", "minimum": 0 },
        "port_shape": {
          "type": "string",
          "enum": ["circle", "square", "triangle", "custom"]
        }
      }
    },
    "label_style": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "position": {
          "type": "string",
          "enum": ["top", "bottom", "left", "right", "center"]
        },
        "alignment": {
          "type": "string",
          "enum": ["left", "center", "right"]
        },
        "font_family": { "type": "string" },
        "font_size": { "type": "number", "minimum": 1 },
        "bold": { "type": "boolean" },
        "italic": { "type": "boolean" }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "resizable": { "type": "boolean" },
        "collapsible": { "type": "boolean" },
        "previewable": { "type": "boolean" },
        "printable": { "type": "boolean" },
        "lockable": { "type": "boolean" },
        "editable_ports": { "type": "boolean" }
      }
    },
    "fallback_behavior": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "shape": {
          "type": "string",
          "enum": ["rect", "round_rect", "hex", "diamond", "custom"]
        },
        "show_warning_badge": { "type": "boolean" },
        "show_type_text": { "type": "boolean" },
        "use_generic_ports": { "type": "boolean" },
        "message": { "type": "string" }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  }
}

