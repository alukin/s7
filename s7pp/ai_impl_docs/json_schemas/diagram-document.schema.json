{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://s7.example/schemas/diagram-document.schema.json",
  "title": "S7 Diagram Document Schema v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "dt", "diagram"],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "dt": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "diagram_version": {
      "type": "integer",
      "const": 1
    },
    "diagram": {
      "$ref": "#/$defs/diagramDocument"
    }
  },
  "$defs": {
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" }
      }
    },
    "size": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node", "connector"],
      "properties": {
        "node": { "type": "string", "minLength": 1 },
        "connector": { "type": "string", "minLength": 1 }
      }
    },
    "port": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "direction", "signal_type", "domain"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "direction": { "type": "string", "enum": ["input", "output"] },
        "signal_type": { "type": "string", "minLength": 1 },
        "domain": { "type": "string", "minLength": 1 },
        "max_connections": { "type": "integer", "minimum": 1 },
        "label": { "type": "string" },
        "color": { "type": "string" },
        "locked": { "type": "boolean" }
      }
    },
    "style": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "shape": {
          "type": "string",
          "enum": ["rect", "round_rect", "hex", "diamond", "custom"]
        },
        "icon": { "type": "string" },
        "color": { "type": "string" },
        "palette_icon": { "type": "string" },
        "label_position": {
          "type": "string",
          "enum": ["top", "bottom", "left", "right", "center"]
        },
        "node_style": { "type": "object" },
        "port_style": { "type": "object" },
        "label_style": { "type": "object" }
      }
    },
    "schemaInterface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inputs", "outputs"],
      "properties": {
        "inputs": {
          "type": "array",
          "items": { "$ref": "#/$defs/port" }
        },
        "outputs": {
          "type": "array",
          "items": { "$ref": "#/$defs/port" }
        }
      }
    },
    "schemaBody": {
      "type": "object",
      "additionalProperties": false,
      "oneOf": [
        { "required": ["ref"] },
        { "required": ["diagram"] }
      ],
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1,
          "description": "Reference to an external schema document or library entry"
        },
        "diagram": {
          "$ref": "#/$defs/diagramDocument"
        }
      }
    },
    "schemaDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "interface", "body"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "version": { "type": "string", "minLength": 1 },
        "interface": { "$ref": "#/$defs/schemaInterface" },
        "body": { "$ref": "#/$defs/schemaBody" },
        "metadata": { "type": "object", "additionalProperties": true }
      }
    },
    "diagramNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "position"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "kind": {
          "type": "string",
          "enum": ["primitive", "schema", "visual"]
        },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "position": { "$ref": "#/$defs/point" },
        "size": { "$ref": "#/$defs/size" },
        "ports": {
          "type": "array",
          "items": { "$ref": "#/$defs/port" }
        },
        "input_ports": { "type": "integer", "minimum": 0 },
        "output_ports": { "type": "integer", "minimum": 0 },
        "params": { "type": "object", "additionalProperties": true },
        "visual": { "type": "boolean" },
        "locked": { "type": "boolean" },
        "collapsed": { "type": "boolean" },
        "layer": { "type": "string" },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "style": { "$ref": "#/$defs/style" },
        "interface": { "$ref": "#/$defs/schemaInterface" },
        "body": { "$ref": "#/$defs/schemaBody" },
        "schema_ref": { "type": "string", "minLength": 1 },
        "metadata": { "type": "object", "additionalProperties": true }
      },
      "allOf": [
        {
          "if": {
            "properties": { "kind": { "const": "schema" } },
            "required": ["kind"]
          },
          "then": {
            "required": ["interface", "body"]
          }
        },
        {
          "if": {
            "properties": { "kind": { "const": "visual" } },
            "required": ["kind"]
          },
          "then": {
            "properties": {
              "visual": { "const": true }
            }
          }
        }
      ]
    },
    "diagramWire": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "name": { "type": "string" },
        "from": { "$ref": "#/$defs/endpoint" },
        "to": { "$ref": "#/$defs/endpoint" },
        "points": {
          "type": "array",
          "items": { "$ref": "#/$defs/point" }
        },
        "locked": { "type": "boolean" },
        "style": { "$ref": "#/$defs/style" },
        "metadata": { "type": "object", "additionalProperties": true }
      }
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "bounds"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "bounds": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y", "width", "height"],
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" },
            "width": { "type": "number", "exclusiveMinimum": 0 },
            "height": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        "locked": { "type": "boolean" },
        "metadata": { "type": "object", "additionalProperties": true }
      }
    },
    "annotation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "position"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "text": { "type": "string" },
        "position": { "$ref": "#/$defs/point" },
        "size": { "$ref": "#/$defs/size" },
        "locked": { "type": "boolean" },
        "style": { "$ref": "#/$defs/style" },
        "metadata": { "type": "object", "additionalProperties": true }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 },
        "margin": { "type": "number", "minimum": 0 },
        "orientation": { "type": "string", "enum": ["portrait", "landscape"] },
        "title": { "type": "string" },
        "author": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      }
    },
    "viewport": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "center": { "$ref": "#/$defs/point" },
        "zoom": { "type": "number", "exclusiveMinimum": 0 },
        "locked": { "type": "boolean" }
      }
    },
    "diagramDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "nodes", "wires"],
      "properties": {
        "version": { "type": "integer", "const": 1 },
        "nodes": {
          "type": "array",
          "items": { "$ref": "#/$defs/diagramNode" }
        },
        "wires": {
          "type": "array",
          "items": { "$ref": "#/$defs/diagramWire" }
        },
        "schemas": {
          "type": "array",
          "items": { "$ref": "#/$defs/schemaDefinition" }
        },
        "groups": {
          "type": "array",
          "items": { "$ref": "#/$defs/group" }
        },
        "annotations": {
          "type": "array",
          "items": { "$ref": "#/$defs/annotation" }
        },
        "page": { "$ref": "#/$defs/page" },
        "viewport": { "$ref": "#/$defs/viewport" },
        "metadata": { "type": "object", "additionalProperties": true }
      }
    }
  }
}

